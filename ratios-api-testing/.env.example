# Copy this file to .env and fill in real values. Never commit .env itself.

# Base URL of the Ratios API
RATIOS_BASE_URL=https://api.ratios.dk

# Public "apikey" header value from the Ratios API docs (Authentication section).
# Documented as a publishable/public key, but still keep it in env config rather than
# hardcoded in scripts so sandbox/prod can be swapped without editing code.
RATIOS_API_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dedicated test/service account credentials (must have the "API-adgang" role assigned).
# Do NOT use a personal login here.
RATIOS_EMAIL=api-test@yourcompany.dk
RATIOS_PASSWORD=change-me

# tenant_id to run tests against. Obtain by authenticating once and calling GET /api/tenants.
# STRONGLY prefer a sandbox/test tenant over a production tenant with real client data.
RATIOS_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Partner OAuth2 (only needed for Phase 6 / partner flow tests) ---
RATIOS_PARTNER_CLIENT_ID=
RATIOS_PARTNER_CLIENT_SECRET=
RATIOS_PARTNER_REDIRECT_URI=https://your-app.com/oauth/callback

# Prefix used on every record created by the test suite, so test data is easy to find and purge.
RATIOS_TEST_PREFIX=ZZ_QA_
