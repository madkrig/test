{
  "name": "cedra-penneo-esignering",
  "version": "0.1.0",
  "private": true,
  "description": "Workflowprototype for e-signering via Penneo (Markedsplads → Penneo → SharePoint). Syntetiske data.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push --skip-generate",
    "seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "setup": "prisma db push --skip-generate && tsx --tsconfig tsconfig.json scripts/seed.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  }
}
